{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@studio/*": ["../src/features/studio/*"],
      "@lib/*": ["../src/lib/*"],
      "@context/*": ["../src/context/*"],
      "@components/*": ["../src/components/*"],
      "@services/*": ["../src/services/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src", "../src/features/studio", "../src/features/void", "../src/lib", "../src/context", "../src/services", "../src/components"]
}
