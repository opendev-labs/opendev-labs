{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@studio/*": ["./studio/*"],
      "@lib/*": ["./lib/*"],
      "@context/*": ["./context/*"],
      "@components/*": ["./components/*"],
      "@services/*": ["./services/*"],
      "@/*": ["./*"]
    }
  },
  "include": ["src", "studio", "void", "lib", "context", "services", "components"]
}
